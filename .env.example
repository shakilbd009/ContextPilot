APP_PORT=8080
FRONTEND_PORT=5173
DATABASE_PORT=5432
CACHE_PORT=6379

MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

DATABASE_URL=postgres://contextpilot:***@localhost:5432/contextpilot?sslmode=disable
REDIS_URL=redis://localhost:***@local.test
EMAIL_FROM_NAME=ContextPilot
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_CAPTURE_WEB_URL=http://localhost:8025

# Feature flags (backend/server)
FF_ENABLE_APP_SHELL=false
FF_ENABLE_MANUAL_MEETING_IMPORT=false
FF_ENABLE_MEETING_MEMORY_PROCESSING=false
FF_ENABLE_PRE_CALL_BRIEFING=false
FF_ENABLE_UPCOMING_MEETINGS=true
FF_ENABLE_PROVIDER_CONNECTORS=false
FF_ENABLE_PRIVACY_RETENTION_CONTROLS=false
FF_ENABLE_MANUAL_MEMORY_CORRECTION=false

# Feature flags (browser-exposed, Vite-prefixed — no secrets)
PUBLIC_VITE_FF_ENABLE_APP_SHELL=false
VITE_FF_ENABLE_MANUAL_MEETING_IMPORT=false
VITE_FF_ENABLE_MEETING_MEMORY_PROCESSING=false
VITE_FF_ENABLE_PRE_CALL_BRIEFING=false
VITE_FF_ENABLE_UPCOMING_MEETINGS=true
VITE_FF_ENABLE_PROVIDER_CONNECTORS=false
VITE_FF_ENABLE_PRIVACY_RETENTION_CONTROLS=false
VITE_FF_ENABLE_MANUAL_MEMORY_CORRECTION=false

# Rate limiting for POST /meetings import endpoint
# Applied when FF_ENABLE_MANUAL_MEETING_IMPORT=true
RATE_LIMIT_IMPORT_MAX_REQUESTS=100
RATE_LIMIT_IMPORT_WINDOW_SECS=60

# Rate limiting for upload endpoints (future use)
RATE_LIMIT_UPLOAD_MAX_REQUESTS=10
RATE_LIMIT_UPLOAD_WINDOW_SECS=60